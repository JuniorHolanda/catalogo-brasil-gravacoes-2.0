# Configure em .env.local no desenvolvimento e nas variáveis do ambiente de produção.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brasil-gravacoes

# Autenticação. Defina um segredo aleatório longo e a URL deste ambiente.
BETTER_AUTH_SECRET=<segredo-aleatorio-com-32-ou-mais-caracteres>
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alertas de armazenamento enviados pelo Resend para juniorholanda@outlook.com.
# O remetente precisa estar verificado no domínio configurado no Resend.
RESEND_API_KEY=
STORAGE_ALERT_FROM=alertas@seudominio.com

# Token R2 limitado ao bucket exclusivo da aplicação, com leitura, listagem,
# gravação e exclusão de objetos.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
