{
  "name": "brasil-gravacoes-web-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "packages/domain"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test:auth": "node scripts/test-auth.mjs",
    "api:dev": "npm run dev --workspace @brasil-gravacoes/backend",
    "api:build": "npm run build --workspace @brasil-gravacoes/backend",
    "api:start": "npm run start --workspace @brasil-gravacoes/backend",
    "api:lint": "npm run lint --workspace @brasil-gravacoes/backend"
  },
  "dependencies": {
    "@brasil-gravacoes/domain": "*",
    "better-auth": "^1.7.10",
    "motion": "^14.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "styled-components": "^6.3.0",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
