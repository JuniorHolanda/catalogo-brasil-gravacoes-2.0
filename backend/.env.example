# Banco MongoDB Atlas usado somente pela API.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites&w=majority
MONGODB_DB=brasil-gravacoes

# Better Auth e origens autorizadas para cookies/CORS.
BETTER_AUTH_SECRET=<segredo-aleatorio-com-32-ou-mais-caracteres>
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_ORIGINS=http://localhost:3000
ADMIN_EMAILS=juniorholanda@outlook.com

# OAuth Google (opcional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verificação de contas e alertas de armazenamento por e-mail. O remetente precisa
# estar verificado no domínio configurado no Resend.
RESEND_API_KEY=
STORAGE_ALERT_FROM=alertas@seudominio.com

# Cloudflare R2.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
